PORT=5000
# Use production only with an explicit remote/runtime URI, strong secret, and HTTPS origins.
# NODE_ENV=production
URI=mongodb+srv://username:password@cluster.example.mongodb.net/forgesavant?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-secure-random-secret
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
CATALOG_FRESHNESS_HOURS=24
ADMIN_EMAILS=admin@example.com

# Official Flipkart Affiliate API (used only by data-pipeline/sync_retailer.py)
FLIPKART_AFFILIATE_ID=replace-with-your-affiliate-tracking-id
FLIPKART_AFFILIATE_TOKEN=replace-with-your-private-api-token

# Open Icecat catalog access (used only by the data pipeline)
ICECAT_USERNAME=your-open-icecat-username
ICECAT_PASSWORD=your-open-icecat-password
ICECAT_LANGUAGE=EN

# Optional dashboard freshness threshold; one week by default.
PIPELINE_FRESHNESS_HOURS=168
